# 3. OPENAI API-BASED CHATBOT (Template)
# =====================================================================
from openai import OpenAI

def run_openai_chat(api_key="your_api_key"):
    if api_key == "your_api_key":
        print("Skipping OpenAI execution: Please provide a valid API key first.")
        return

    client = OpenAI(api_key=api_key)
    messages = [
        {"role": "system", "content": "You are a supportive mental health assistant. Be empathetic, do not give medical advice, and encourage seeking help if needed."}
    ]

    print("Chatbot (OpenAI): Connected. (Type 'quit' to exit)")
    while True:
        user_input = input("You: ")
        if user_input.lower() in ["quit", "exit"]:
            print("Chatbot (OpenAI): Goodbye!")
            break
            
        messages.append({"role": "user", "content": user_input})
        response = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=messages
        )
        reply = response.choices[0].message.content
        print("Bot:", reply)
        messages.append({"role": "assistant", "content": reply})

