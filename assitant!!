# 2. NLTK RULE-BASED CHATBOT
# =====================================================================
import nltk
from nltk.chat.util import Chat, reflections

# Define pairs of patterns and responses
pairs = [
    [r"hi|hello", ["Hello! How can I assist you today?"]],
    [r"my name is (.*)", ["Nice to meet you, %1!"]],
    [r"what is your name?", ["I'm a simple chatbot built in Python."]],
    [r"how are you?", ["I'm doing great, thanks for asking!"]],
    [r"quit", ["Goodbye! Have a nice day."]]
]

def run_nltk_chat():
    print("Chatbot (NLTK): Starting NLTK Chatbot session. (Type 'quit' to exit)")
    chatbot = Chat(pairs, reflections)
    chatbot.converse()

